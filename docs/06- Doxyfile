
# Project Information
PROJECT_NAME           = "TW Documentation Project"
PROJECT_BRIEF          = "C++ Code Documentation using Doxygen"
PROJECT_NUMBER         = 1.0

# Input Files
INPUT                  = .
FILE_PATTERNS          = *.cpp
RECURSIVE              = NO

# Output Directory
OUTPUT_DIRECTORY       = generated-docs

# Documentation Settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES

# HTML Documentation
GENERATE_HTML          = YES
HTML_OUTPUT            = html

# LaTeX Documentation
GENERATE_LATEX         = NO

# Warnings
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

# Graph Settings
HAVE_DOT               = NO

# Display Settings
QUIET                  = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
